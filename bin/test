#!/bin/bash
# Script to run tests for devhago-health-check gem

set -e

echo "🧪 Running DevhagoHealthCheck Gem Tests"
echo "========================================"
echo ""

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if bundle is installed
if ! command -v bundle &> /dev/null; then
    echo -e "${RED}❌ Bundler not found. Please install it first: gem install bundler${NC}"
    exit 1
fi

# Install dependencies if needed
if [ ! -d "vendor/bundle" ] && [ ! -f ".bundle/config" ]; then
    echo -e "${YELLOW}📦 Installing dependencies...${NC}"
    bundle install
    echo ""
fi

# Run tests
echo -e "${YELLOW}🏃 Running tests...${NC}"
echo ""

if bundle exec rake test; then
    echo ""
    echo -e "${GREEN}✅ All tests passed!${NC}"
    echo ""
    
    # Show test statistics
    bundle exec rake test_stats
    
    exit 0
else
    echo ""
    echo -e "${RED}❌ Tests failed!${NC}"
    exit 1
fi
